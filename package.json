    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets",
    "scripts"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node scripts/smoke-test.cjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model",
    "hot-switch",
    "auto-switch",
    "vision",
    "multimodal",
    "image",
    "识图",
    "模型",
    "自动切换"
  ],
  "author": {
    "name": "SHUJILAI",
    "url": "https://github.com/SHUJILAI"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SHUJILAI/dsh-model-auto-hot-switch.git"
  },
  "homepage": "https://github.com/SHUJILAI/dsh-model-auto-hot-switch#readme",
  "bugs": {
    "url": "https://github.com/SHUJILAI/dsh-model-auto-hot-switch/issues"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  }
}
