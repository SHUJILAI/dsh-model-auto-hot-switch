{
  "name": "dsh-model-auto-hot-switch",
  "version": "0.1.0",
  "description": "Automatic per-task model hot-switching for DeepSeek Harness (dsh): image-aware tasks route to the vision model automatically, every other task keeps your default model. Zero extra tokens, no context disturbance.",
